# Privacy filter function for device properties:
# Excludes IMEI, MEID, serial numbers, MAC addresses, ICCID, IMSI, phone numbers,
# tokens, and CPU IDs from properties to ensure user privacy when sharing logs.
sanitize_privacy_props() {
  local target_file="$1"
  [ ! -f "$target_file" ] && return 0
  local tmp_file="${target_file}.tmp.$$"

  grep -v -i -E "(imei|meid|serialno|serial_no|serial_number|^ro\.serial|cpuid|wifimac|btmac|macaddr|mac_addr|bd_addr|iccid|preiccid|imsi|msisdn|phone_number|phonenumber|line1|android_id|device_id|token|password|secret|credential|net\.hostname)" "$target_file" 2>/dev/null \
    | sed -E 's/([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/[REDACTED_MAC]/g' > "$tmp_file" 2>/dev/null \
    && mv -f "$tmp_file" "$target_file" 2>/dev/null || true
  rm -f "$tmp_file" 2>/dev/null || true
}

