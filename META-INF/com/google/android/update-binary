#!/sbin/sh
# ==============================================================================
# POX LOGS DUMPER (poxlogsdumper v2.0 - Ultimate Edition)
# Custom Recovery Flashable Diagnostic Log Dumper
#
# Anti-Stuck & Zero-Failure Guarantees:
# - Active watchdog timeout (run_with_timeout) prevents any command from freezing
# - Non-blocking partition mounts with direct block node fallbacks
# - Missing files/directories are skipped smoothly without errors
# - Automated lazy unmounting (umount -l) ensures clean unmount without locking
# - Guaranteed fallback to /tmp ensures archive is ALWAYS created
# - 100% Safe: Never flashes, formats, or modifies any device partition
# ==============================================================================

# Setup recovery output pipe (TWRP / OrangeFox / PBRP / AOSP)
OUTFD=$2
ZIPFILE="$3"

# Find file descriptor for TWRP ui_print
if [ -z "$OUTFD" ] || [ ! -e "/proc/self/fd/$OUTFD" ]; then
    OUTFD=1
fi

ui_print() {
    if [ "$OUTFD" != "1" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
        echo "ui_print $1" > "/proc/self/fd/$OUTFD"
        echo "ui_print " > "/proc/self/fd/$OUTFD"
    else
        echo "$1"
    fi
}

set_progress() {
    if [ "$OUTFD" != "1" ] && [ -e "/proc/self/fd/$OUTFD" ]; then
        echo "set_progress $1" > "/proc/self/fd/$OUTFD"
    fi
}

# Watchdog runner: Prevents ANY command from hanging or getting stuck indefinitely
run_with_timeout() {
  local max_sec="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$max_sec" "$@" 2>/dev/null || true
  elif command -v busybox >/dev/null 2>&1 && busybox timeout --help >/dev/null 2>&1; then
    busybox timeout "$max_sec" "$@" 2>/dev/null || true
  elif command -v toybox >/dev/null 2>&1 && toybox timeout --help >/dev/null 2>&1; then
    toybox timeout "$max_sec" "$@" 2>/dev/null || true
  else
    # Background execution with watchdog kill
    "$@" 2>/dev/null &
    local cmd_pid=$!
    (
      local count=0
      while [ "$count" -lt "$max_sec" ]; do
        kill -0 $cmd_pid 2>/dev/null || exit 0
        sleep 1
        count=$((count + 1))
      done
      kill -9 $cmd_pid 2>/dev/null || true
    ) &
    local watch_pid=$!
    wait $cmd_pid 2>/dev/null || true
    kill -9 $watch_pid 2>/dev/null || true
  fi
}

# Banner
ui_print " "
ui_print "  ____   _____  __   ____  ____   ___     _ _____ ____ _____ "
ui_print " |  _ \ / _ \ \/ /  |  _ \|  _ \ / _ \   | | ____/ ___|_   _| "
ui_print " | |_) | | | \  /   | |_) | |_) | | | | _| |  _|| |     | |  "
ui_print " |  __/| |_| /  \   |  __/|  _ <| |_| || |_| |__| |___  | |  "
ui_print " |_|    \___/_/\_\  |_|   |_| \_\\___/ \___/|_____\____| |_|  "
ui_print " ========================================================= "
ui_print "   POX LOGS DUMPER v2.0  •  Diagnostic Log Collector     "
ui_print "   Maintainer: txorav                                     "
ui_print " ========================================================= "
ui_print " "

set_progress 0.05

# Setup paths
WORKDIR="/tmp/poxlogsdumper_backend"
STAGING_DIR="/tmp/poxlogsdumper_staging"
rm -rf "$WORKDIR" "$STAGING_DIR" 2>/dev/null || true
mkdir -p "$WORKDIR" "$STAGING_DIR" 2>/dev/null || true

# Cleanup trap to ensure zero hanging mounts or dangling files on exit
MOUNT_CLEANUP=""
cleanup_exit() {
  for m in $MOUNT_CLEANUP; do
    umount -l "$m" 2>/dev/null || umount "$m" 2>/dev/null || true
  done
  rm -rf "$WORKDIR" "$STAGING_DIR" 2>/dev/null || true
}
trap cleanup_exit INT TERM

# Resolve ZIPFILE path if not passed cleanly by recovery
if [ -z "$ZIPFILE" ] || [ ! -f "$ZIPFILE" ]; then
    for candidate in "$3" "$ZIP_FILE" /tmp/update.zip /sdcard/Download/poxlogsdumper.zip /sdcard/Downloads/poxlogsdumper.zip /sdcard/poxlogsdumper.zip /data/media/0/Download/poxlogsdumper.zip; do
        if [ -f "$candidate" ]; then
            ZIPFILE="$candidate"
            break
        fi
    done
fi

# Extract tools if running from zip
if [ -n "$ZIPFILE" ] && [ -f "$ZIPFILE" ]; then
    ui_print "[-] Extracting backend utilities..."
    (cd "$WORKDIR" && unzip -qo "$ZIPFILE" "tools/*" >/dev/null 2>&1) || \
    (cd "$WORKDIR" && busybox unzip -qo "$ZIPFILE" "tools/*" >/dev/null 2>&1) || \
    unzip -qo "$ZIPFILE" "tools/*" -d "$WORKDIR" >/dev/null 2>&1 || true
    chmod -R 755 "$WORKDIR/tools" 2>/dev/null || true
fi

set_progress 0.10

# Safe partition mounting (Non-blocking, anti-stuck, zero-failure guarantee)
safe_mount_ro() {
  local mpoint="$1"
  if ! mount 2>/dev/null | grep -q " $mpoint "; then
    if run_with_timeout 4 mount -o ro "$mpoint" || run_with_timeout 4 mount "$mpoint"; then
      mount 2>/dev/null | grep -q " $mpoint " && MOUNT_CLEANUP="$MOUNT_CLEANUP $mpoint"
    else
      for bdev in "/dev/block/by-name/${mpoint#/}" "/dev/block/bootdevice/by-name/${mpoint#/}" "/dev/block/mapper/${mpoint#/}"; do
        if [ -b "$bdev" ]; then
          mkdir -p "$mpoint" 2>/dev/null || true
          if run_with_timeout 4 mount -o ro -t auto "$bdev" "$mpoint"; then
            mount 2>/dev/null | grep -q " $mpoint " && MOUNT_CLEANUP="$MOUNT_CLEANUP $mpoint"
            break
          fi
        fi
      done
    fi
  fi
  return 0
}

safe_mount_rw() {
  local mpoint="$1"
  if ! mount 2>/dev/null | grep -q " $mpoint "; then
    if run_with_timeout 4 mount "$mpoint"; then
      mount 2>/dev/null | grep -q " $mpoint " && MOUNT_CLEANUP="$MOUNT_CLEANUP $mpoint"
    else
      for bdev in "/dev/block/by-name/${mpoint#/}" "/dev/block/bootdevice/by-name/${mpoint#/}" "/dev/block/mapper/${mpoint#/}"; do
        if [ -b "$bdev" ]; then
          mkdir -p "$mpoint" 2>/dev/null || true
          if run_with_timeout 4 mount -t auto "$bdev" "$mpoint"; then
            mount 2>/dev/null | grep -q " $mpoint " && MOUNT_CLEANUP="$MOUNT_CLEANUP $mpoint"
            break
          fi
        fi
      done
    fi
  fi
  return 0
}

ui_print "[-] Mounting partitions (safe non-blocking)..."
safe_mount_rw /cache
safe_mount_rw /data
safe_mount_ro /system
safe_mount_ro /system_root
safe_mount_ro /vendor
safe_mount_ro /product
safe_mount_ro /system_ext

# Explicitly mount pstore if not already mounted (never hangs or stops)
if ! mount 2>/dev/null | grep -q " /sys/fs/pstore "; then
  mkdir -p /sys/fs/pstore 2>/dev/null || true
  if run_with_timeout 3 mount -t pstore pstore /sys/fs/pstore; then
    mount 2>/dev/null | grep -q " /sys/fs/pstore " && {
      ui_print "[-] Mounted /sys/fs/pstore filesystem"
      MOUNT_CLEANUP="$MOUNT_CLEANUP /sys/fs/pstore"
    }
  fi
fi

# Explicitly mount debugfs if not already mounted
if ! mount 2>/dev/null | grep -q " /sys/kernel/debug "; then
  mkdir -p /sys/kernel/debug 2>/dev/null || true
  if run_with_timeout 3 mount -t debugfs none /sys/kernel/debug; then
    mount 2>/dev/null | grep -q " /sys/kernel/debug " && {
      MOUNT_CLEANUP="$MOUNT_CLEANUP /sys/kernel/debug"
    }
  fi
fi

set_progress 0.15

# Determine target output storage
# Priority: /sdcard -> /data/media/0 -> /data -> /cache -> /tmp
TARGET_DIR=""

check_writable_and_space() {
  local dir="$1"
  [ -d "$dir" ] || return 1
  local test_file="$dir/.pox_test_$$"
  if touch "$test_file" 2>/dev/null; then
    rm -f "$test_file" 2>/dev/null
    # Require at least 5MB free (5120 KB)
    local free_kb=$(df -k "$dir" 2>/dev/null | tail -n 1 | awk '{print $(NF-2)}')
    if [ -n "$free_kb" ] && [ "$free_kb" -gt 5120 ] 2>/dev/null; then
      return 0
    fi
    return 0 # Write succeeded, proceed even if df syntax varies
  fi
  return 1
}

for candidate in "/sdcard" "/data/media/0" "/data" "/cache" "/tmp"; do
  if check_writable_and_space "$candidate"; then
    TARGET_DIR="$candidate"
    break
  fi
done

[ -n "$TARGET_DIR" ] || TARGET_DIR="/tmp"

ui_print "[-] Destination storage   : $TARGET_DIR"

# Determine output filename: logsYYMMDD.zip
DATE_TAG=$(date +%y%m%d 2>/dev/null)
if [ -z "$DATE_TAG" ] || [ "$DATE_TAG" = "unknown" ]; then
  DATE_TAG=$(date +%Y%m%d 2>/dev/null | cut -c3-8)
fi
[ -n "$DATE_TAG" ] || DATE_TAG="dump"

ZIP_NAME="logs${DATE_TAG}.zip"
if [ -e "$TARGET_DIR/$ZIP_NAME" ]; then
  TIME_TAG=$(date +%H%M%S 2>/dev/null)
  [ -n "$TIME_TAG" ] || TIME_TAG=$$
  ZIP_NAME="logs${DATE_TAG}_${TIME_TAG}.zip"
fi

OUTPUT_FILE="$TARGET_DIR/$ZIP_NAME"
ui_print "[-] Output archive name   : $ZIP_NAME"
ui_print " "

set_progress 0.20

# Create organized directory structure
mkdir -p "$STAGING_DIR/pstore_ramoops" 2>/dev/null || true
mkdir -p "$STAGING_DIR/kernel" 2>/dev/null || true
mkdir -p "$STAGING_DIR/kernel/debugfs" 2>/dev/null || true
mkdir -p "$STAGING_DIR/kernel/raw_partitions" 2>/dev/null || true
mkdir -p "$STAGING_DIR/recovery" 2>/dev/null || true
mkdir -p "$STAGING_DIR/recovery/cache_recovery" 2>/dev/null || true
mkdir -p "$STAGING_DIR/recovery/orangefox" 2>/dev/null || true
mkdir -p "$STAGING_DIR/android" 2>/dev/null || true
mkdir -p "$STAGING_DIR/android/dropbox" 2>/dev/null || true
mkdir -p "$STAGING_DIR/android/anr" 2>/dev/null || true
mkdir -p "$STAGING_DIR/android/tombstones" 2>/dev/null || true
mkdir -p "$STAGING_DIR/android/crash_dumps" 2>/dev/null || true
mkdir -p "$STAGING_DIR/android/oem_logs" 2>/dev/null || true
mkdir -p "$STAGING_DIR/root" 2>/dev/null || true
mkdir -p "$STAGING_DIR/device_info" 2>/dev/null || true
mkdir -p "$STAGING_DIR/hardware" 2>/dev/null || true
mkdir -p "$STAGING_DIR/partition_tables" 2>/dev/null || true
mkdir -p "$STAGING_DIR/partition_tables/raw_gpt" 2>/dev/null || true
mkdir -p "$STAGING_DIR/partition_tables/tools_output" 2>/dev/null || true
mkdir -p "$STAGING_DIR/partition_tables/super_dynamic" 2>/dev/null || true

# Detect strings binary if available
STRINGS_BIN=""
if command -v strings >/dev/null 2>&1; then
  STRINGS_BIN="strings"
elif command -v busybox >/dev/null 2>&1 && busybox strings --help >/dev/null 2>&1; then
  STRINGS_BIN="busybox strings"
elif command -v toybox >/dev/null 2>&1 && toybox strings --help >/dev/null 2>&1; then
  STRINGS_BIN="toybox strings"
fi

# ==============================================================================
# 1. PSTORE, CONSOLE-RAMOOPS & HARDWARE CRASH PARTITIONS
# ==============================================================================
ui_print "[-] [1/8] Collecting pstore, ramoops & crash dumps..."

# /sys/fs/pstore (non-blocking copy)
if [ -d /sys/fs/pstore ]; then
  cp -a /sys/fs/pstore/. "$STAGING_DIR/pstore_ramoops/" 2>/dev/null || true
  ls -la /sys/fs/pstore > "$STAGING_DIR/pstore_ramoops/pstore_directory_list.txt" 2>/dev/null || true
fi

# Legacy /proc/last_kmsg
[ -f /proc/last_kmsg ] && cp -af /proc/last_kmsg "$STAGING_DIR/pstore_ramoops/last_kmsg.txt" 2>/dev/null || true

# Persistent ramoops parameters and devices
[ -d /sys/module/ramoops ] && cp -a /sys/module/ramoops/. "$STAGING_DIR/pstore_ramoops/sys_module_ramoops/" 2>/dev/null || true
[ -f /proc/ramoops ] && cat /proc/ramoops > "$STAGING_DIR/pstore_ramoops/proc_ramoops.txt" 2>/dev/null || true

# Non-blocking pmsg snapshot with watchdog
if [ -c /dev/pmsg0 ]; then
  run_with_timeout 2 head -c 1048576 /dev/pmsg0 > "$STAGING_DIR/pstore_ramoops/pmsg0.bin" || true
  if [ -n "$STRINGS_BIN" ] && [ -s "$STAGING_DIR/pstore_ramoops/pmsg0.bin" ]; then
    run_with_timeout 3 $STRINGS_BIN -n 8 "$STAGING_DIR/pstore_ramoops/pmsg0.bin" > "$STAGING_DIR/pstore_ramoops/pmsg0_strings.txt" || true
  fi
fi

# Hardware partition dump for raw ramoops / expdb / logdump (anti-stuck timeout)
for part in ramoops expdb logdump rawdump minidump apdp; do
  devpath=""
  [ -e "/dev/block/by-name/$part" ] && devpath="/dev/block/by-name/$part"
  [ -e "/dev/block/bootdevice/by-name/$part" ] && devpath="/dev/block/bootdevice/by-name/$part"
  if [ -n "$devpath" ]; then
    ui_print "    -> Reading $part partition ($devpath)"
    run_with_timeout 4 dd if="$devpath" of="$STAGING_DIR/kernel/raw_partitions/${part}_head.bin" bs=1024 count=4096 || true
    if [ -n "$STRINGS_BIN" ] && [ -s "$STAGING_DIR/kernel/raw_partitions/${part}_head.bin" ]; then
      run_with_timeout 3 $STRINGS_BIN -n 8 "$STAGING_DIR/kernel/raw_partitions/${part}_head.bin" > "$STAGING_DIR/kernel/raw_partitions/${part}_strings.txt" || true
    fi
  fi
done

set_progress 0.35

# ==============================================================================
# 2. COMPLETE KERNEL DMESG & DEBUGFS TRACES
# ==============================================================================
ui_print "[-] [2/8] Dumping kernel dmesg, kmsg & ftrace..."

# Complete dmesg ring buffers with watchdog timeout
run_with_timeout 4 dmesg -s 4194304 > "$STAGING_DIR/kernel/dmesg.txt" || true
[ ! -s "$STAGING_DIR/kernel/dmesg.txt" ] && run_with_timeout 4 dmesg > "$STAGING_DIR/kernel/dmesg.txt" || true
run_with_timeout 4 dmesg -T > "$STAGING_DIR/kernel/dmesg_timestamps.txt" || true
run_with_timeout 3 dmesg -k > "$STAGING_DIR/kernel/dmesg_kernel_only.txt" || true
run_with_timeout 3 dmesg -u > "$STAGING_DIR/kernel/dmesg_userspace.txt" || true

# Kernel proc statistics and memory maps (sanitized for privacy)
if [ -f /proc/cmdline ]; then
  cat /proc/cmdline 2>/dev/null | sed -E \
    -e 's/(androidboot\.serialno=)[^ ]*/\1[REDACTED]/g' \
    -e 's/(androidboot\.wifimacaddr=)[^ ]*/\1[REDACTED]/g' \
    -e 's/(androidboot\.btmacaddr=)[^ ]*/\1[REDACTED]/g' \
    -e 's/(androidboot\.cpuid=)[^ ]*/\1[REDACTED]/g' \
    -e 's/([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/[REDACTED_MAC]/g' \
    > "$STAGING_DIR/kernel/cmdline.txt" 2>/dev/null || true
fi
if [ -f /proc/bootconfig ]; then
  cat /proc/bootconfig 2>/dev/null | sed -E \
    -e 's/(androidboot\.serialno[ \t]*=[ \t]*)[^ \n]*/\1"[REDACTED]"/g' \
    -e 's/(androidboot\.wifimacaddr[ \t]*=[ \t]*)[^ \n]*/\1"[REDACTED]"/g' \
    -e 's/(androidboot\.btmacaddr[ \t]*=[ \t]*)[^ \n]*/\1"[REDACTED]"/g' \
    -e 's/(androidboot\.cpuid[ \t]*=[ \t]*)[^ \n]*/\1"[REDACTED]"/g' \
    -e 's/([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}/[REDACTED_MAC]/g' \
    > "$STAGING_DIR/kernel/bootconfig.txt" 2>/dev/null || true
fi
[ -f /proc/version ] && cat /proc/version > "$STAGING_DIR/kernel/version.txt" 2>/dev/null || true
[ -f /proc/sched_debug ] && cat /proc/sched_debug > "$STAGING_DIR/kernel/sched_debug.txt" 2>/dev/null || true
[ -f /proc/timer_list ] && cat /proc/timer_list > "$STAGING_DIR/kernel/timer_list.txt" 2>/dev/null || true
[ -f /proc/interrupts ] && cat /proc/interrupts > "$STAGING_DIR/kernel/interrupts.txt" 2>/dev/null || true
[ -f /proc/softirqs ] && cat /proc/softirqs > "$STAGING_DIR/kernel/softirqs.txt" 2>/dev/null || true
[ -f /proc/vmstat ] && cat /proc/vmstat > "$STAGING_DIR/kernel/vmstat.txt" 2>/dev/null || true
[ -f /proc/zoneinfo ] && cat /proc/zoneinfo > "$STAGING_DIR/kernel/zoneinfo.txt" 2>/dev/null || true
[ -f /proc/slabinfo ] && cat /proc/slabinfo > "$STAGING_DIR/kernel/slabinfo.txt" 2>/dev/null || true
[ -f /proc/vmallocinfo ] && cat /proc/vmallocinfo > "$STAGING_DIR/kernel/vmallocinfo.txt" 2>/dev/null || true
[ -f /proc/pagetypeinfo ] && cat /proc/pagetypeinfo > "$STAGING_DIR/kernel/pagetypeinfo.txt" 2>/dev/null || true
[ -f /proc/buddyinfo ] && cat /proc/buddyinfo > "$STAGING_DIR/kernel/buddyinfo.txt" 2>/dev/null || true
[ -f /proc/modules ] && cat /proc/modules > "$STAGING_DIR/kernel/modules.txt" 2>/dev/null || true
[ -f /proc/diskstats ] && cat /proc/diskstats > "$STAGING_DIR/kernel/diskstats.txt" 2>/dev/null || true
[ -f /proc/stat ] && cat /proc/stat > "$STAGING_DIR/kernel/stat.txt" 2>/dev/null || true
[ -f /proc/uptime ] && cat /proc/uptime > "$STAGING_DIR/kernel/uptime.txt" 2>/dev/null || true
[ -f /proc/loadavg ] && cat /proc/loadavg > "$STAGING_DIR/kernel/loadavg.txt" 2>/dev/null || true

# Kernel symbols summary
[ -f /proc/kallsyms ] && head -n 100 /proc/kallsyms > "$STAGING_DIR/kernel/kallsyms_head.txt" 2>/dev/null || true

# Debugfs traces (binder, wakeup, clk, regulators)
if [ -d /sys/kernel/debug ]; then
  [ -f /sys/kernel/debug/wakeup_sources ] && cp -af /sys/kernel/debug/wakeup_sources "$STAGING_DIR/kernel/debugfs/wakeup_sources.txt" 2>/dev/null || true
  if [ -d /sys/kernel/debug/binder ]; then
    mkdir -p "$STAGING_DIR/kernel/debugfs/binder" 2>/dev/null
    cp -a /sys/kernel/debug/binder/. "$STAGING_DIR/kernel/debugfs/binder/" 2>/dev/null || true
  fi
  if [ -d /sys/kernel/debug/clk ]; then
    [ -f /sys/kernel/debug/clk/clk_summary ] && cp -af /sys/kernel/debug/clk/clk_summary "$STAGING_DIR/kernel/debugfs/clk_summary.txt" 2>/dev/null || true
  fi
  if [ -d /sys/kernel/debug/tracing ]; then
    [ -f /sys/kernel/debug/tracing/trace ] && run_with_timeout 4 head -c 10485760 /sys/kernel/debug/tracing/trace > "$STAGING_DIR/kernel/debugfs/ftrace.txt" || true
  fi
fi

set_progress 0.50

# ==============================================================================
# 3. RECOVERY SESSION LOGS (TWRP, ORANGEFOX, PBRP, SHRP, AOSP)
# ==============================================================================
ui_print "[-] [3/8] Dumping all recovery engine logs..."

# Current recovery session (wildcard safe)
for rlog in /tmp/recovery.log* /tmp/install.log /tmp/twrp.log* /tmp/fox*.log /cache/fox*.log /tmp/pbrp*.log /tmp/shrp*.log /tmp/openrecoveryscript /tmp/stage /tmp/last_log* /tmp/minizip.log /tmp/super_map.log; do
  [ -e "$rlog" ] && cp -af "$rlog" "$STAGING_DIR/recovery/" 2>/dev/null || true
done

# Persistent recovery directories
if [ -d /cache/recovery ]; then
  cp -a /cache/recovery/. "$STAGING_DIR/recovery/cache_recovery/" 2>/dev/null || true
fi
if [ -d /data/cache/recovery ]; then
  mkdir -p "$STAGING_DIR/recovery/data_cache_recovery" 2>/dev/null
  cp -a /data/cache/recovery/. "$STAGING_DIR/recovery/data_cache_recovery/" 2>/dev/null || true
fi
if [ -d /data/system/recovery ]; then
  mkdir -p "$STAGING_DIR/recovery/data_system_recovery" 2>/dev/null
  cp -a /data/system/recovery/. "$STAGING_DIR/recovery/data_system_recovery/" 2>/dev/null || true
fi

# OrangeFox & TWRP storage logs
if [ -d /sdcard/Fox/logs ]; then
  mkdir -p "$STAGING_DIR/recovery/orangefox/sdcard_Fox_logs" 2>/dev/null
  cp -a /sdcard/Fox/logs/. "$STAGING_DIR/recovery/orangefox/sdcard_Fox_logs/" 2>/dev/null || true
fi
if [ -d /cache/Fox ]; then
  mkdir -p "$STAGING_DIR/recovery/orangefox/cache_Fox" 2>/dev/null
  cp -a /cache/Fox/. "$STAGING_DIR/recovery/orangefox/cache_Fox/" 2>/dev/null || true
fi
if [ -d /sdcard/TWRP/logs ]; then
  mkdir -p "$STAGING_DIR/recovery/twrp_sdcard_logs" 2>/dev/null
  cp -a /sdcard/TWRP/logs/. "$STAGING_DIR/recovery/twrp_sdcard_logs/" 2>/dev/null || true
fi

set_progress 0.65

# ==============================================================================
# 4. ANDROID SYSTEM CRASHES, DROPBOX, ANR, TOMBSTONES
# ==============================================================================
ui_print "[-] [4/8] Dumping Android crashes, dropbox & tombstones..."

# Dropbox logs (kernel panics, system server crash, WTF, watchdogs)
if [ -d /data/system/dropbox ]; then
  cp -a /data/system/dropbox/. "$STAGING_DIR/android/dropbox/" 2>/dev/null || true
fi

# ANR traces
if [ -d /data/anr ]; then
  cp -a /data/anr/. "$STAGING_DIR/android/anr/" 2>/dev/null || true
fi

# Tombstones (native crash stack traces)
if [ -d /data/tombstones ]; then
  cp -a /data/tombstones/. "$STAGING_DIR/android/tombstones/" 2>/dev/null || true
fi
if [ -d /data/vendor/tombstones ]; then
  mkdir -p "$STAGING_DIR/android/tombstones/vendor" 2>/dev/null
  cp -a /data/vendor/tombstones/. "$STAGING_DIR/android/tombstones/vendor/" 2>/dev/null || true
fi

# Logd
if [ -d /data/misc/logd ]; then
  mkdir -p "$STAGING_DIR/android/logd" 2>/dev/null
  cp -a /data/misc/logd/. "$STAGING_DIR/android/logd/" 2>/dev/null || true
fi

# MediaTek Crash Logs (AEE - Android Execution Environment)
if [ -d /data/aee_exp ]; then
  mkdir -p "$STAGING_DIR/android/crash_dumps/aee_exp" 2>/dev/null
  cp -a /data/aee_exp/. "$STAGING_DIR/android/crash_dumps/aee_exp/" 2>/dev/null || true
fi
if [ -d /data/vendor/aee_exp ]; then
  mkdir -p "$STAGING_DIR/android/crash_dumps/vendor_aee_exp" 2>/dev/null
  cp -a /data/vendor/aee_exp/. "$STAGING_DIR/android/crash_dumps/vendor_aee_exp/" 2>/dev/null || true
fi
if [ -d /data/vendor/vcore_exp ]; then
  mkdir -p "$STAGING_DIR/android/crash_dumps/vcore_exp" 2>/dev/null
  cp -a /data/vendor/vcore_exp/. "$STAGING_DIR/android/crash_dumps/vcore_exp/" 2>/dev/null || true
fi
if [ -d /proc/aee ]; then
  mkdir -p "$STAGING_DIR/android/crash_dumps/proc_aee" 2>/dev/null
  for f in /proc/aee/*; do
    [ -f "$f" ] && cat "$f" > "$STAGING_DIR/android/crash_dumps/proc_aee/$(basename "$f").txt" 2>/dev/null || true
  done
fi

# Qualcomm Subsystem & RAM Dumps
if [ -d /data/vendor/ramdump ]; then
  mkdir -p "$STAGING_DIR/android/crash_dumps/qc_ramdump" 2>/dev/null
  cp -a /data/vendor/ramdump/. "$STAGING_DIR/android/crash_dumps/qc_ramdump/" 2>/dev/null || true
fi
